# GEMINI_API_KEY: Optional for Gemini AI character dialogue & voice TTS (/api/character/speak).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# VERCEL CLOUD PERSISTENCE (Recommended when hosting on Vercel):
# Link an Upstash Redis / Vercel KV store from the Vercel Marketplace (Storage tab)
# or provide your Upstash REST credentials below so campaign saves persist across
# all serverless invocations and sync across DM & Player browsers.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CAMPAIGN_KV_KEY=aethelgard:campaign_state:v1
